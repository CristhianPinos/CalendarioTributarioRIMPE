# ========================================================
# CONFIGURACIÓN DE ENTORNO: CALENDARIO TRIBUTARIO RIMPE
# ========================================================
# Copie este archivo como '.env' y complete sus credenciales reales.
# NUNCA agregue el archivo '.env' al control de versiones (Git).

# --- ENTORNO Y SERVIDOR ---
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# --- PROVEEDOR LLM & INFERENCIA ---
LLM_PROVIDER=gemini

# Configuración Google Gemini
# Déjela vacía para usar el catálogo de contingencia; configure una clave real para Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Cuotas por instancia para POST /api/obligaciones/explicar (ventana deslizante).
GEMINI_RATE_LIMIT_PER_CLIENT=12
GEMINI_RATE_LIMIT_GLOBAL=30
GEMINI_RATE_LIMIT_WINDOW_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=4096

# --- BASE DE DATOS Y VECTOR STORE ---
# Parámetro legado reservado; la cola operativa usa RIMPE_DB_PATH.
DATABASE_URL=sqlite:///./backend/calendario_rimpe.db
# Repositorio operativo de perfiles y cola; volumen persistente en despliegue.
RIMPE_DB_PATH=./data/processed/rimpe.sqlite3
CHROMA_PERSIST_DIRECTORY=./backend/chroma_db
RAW_DATA_DIRECTORY=./data/raw

# --- REGLAS PARAMÉTRICAS SRI (DESACOPLADAS) ---
SRI_RULES_PATH=./config/sri_rules_2026.json

# --- CORREO TRANSACCIONAL POR API HTTPS DE MAILJET (HITL) ---
# Usar una dirección remitente validada en Mailjet; conservar las claves solo en .env local.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=Calendario RIMPE

# --- PLANIFICADOR HISTÓRICO (NO MONTADO EN LA VERSIÓN PÚBLICA ACTUAL) ---
# Estas variables se conservan para referencia de la etapa 5; no activan el escaneo.
SCHEDULER_ENABLED=false
# Solo para una demo explícita; nunca activar con destinatarios de prueba en producción.
SCHEDULER_ALLOW_DEMO_PROFILES=false
# La ventana de anticipación se configura en config/parametros.yaml.
SCHEDULER_CRON_HOUR=7
SCHEDULER_CRON_MINUTE=0
TIMEZONE=America/Guayaquil
